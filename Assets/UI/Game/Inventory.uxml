<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Game.uss" />
    <!-- Player inventory (PlayerInventoryContentUI): the slots are added in "slots" -->
    <ui:VisualElement name="root" picking-mode="Ignore" class="game-root">
        <ui:VisualElement name="panel" class="game-panel panel-left">
            <ui:Label name="title" text="Inventaire" class="panel-title" />
            <ui:VisualElement name="slots" class="item-grid" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
