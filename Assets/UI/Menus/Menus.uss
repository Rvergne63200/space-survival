/* Shared style of the main menu and the pause menu */

.menu-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 12, 20, 0.85);
}

.menu-panel {
    width: 440px;
    padding: 24px;
    background-color: rgba(30, 34, 48, 0.95);
    border-radius: 8px;
}

/* Hidden panel or element (used by MainMenuUI to switch screens) */
.hidden {
    display: none;
}

.menu-title {
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    margin-bottom: 16px;
}

.menu-button {
    height: 40px;
    font-size: 18px;
    margin-top: 6px;
}

.menu-button-small {
    height: 32px;
    font-size: 14px;
}

.menu-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.menu-grow {
    flex-grow: 1;
}

.menu-field {
    margin-top: 6px;
}

.menu-error {
    color: rgb(255, 110, 110);
    min-height: 20px;
    white-space: normal;
    margin-top: 6px;
}

.menu-info {
    color: rgb(200, 200, 200);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 8px;
    margin-bottom: 8px;
}

.menu-list {
    max-height: 360px;
}

.save-slot {
    flex-direction: row;
    align-items: center;
    padding: 6px;
    margin-bottom: 4px;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 4px;
}

.save-slot-text {
    flex-grow: 1;
}

.save-slot-name {
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
}

.save-slot-info {
    color: rgb(170, 170, 170);
    font-size: 12px;
}

/* Death screen: red filter over the game */
.death-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(140, 0, 0, 0.45);
}

/* Build wheel. The options are placed by BuildWheelUI (radius), centered on their 100 x 100 px size */
.wheel-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.wheel {
    width: 440px;
    height: 440px;
    border-radius: 220px;
    background-color: rgba(20, 24, 36, 0.6);
    align-items: center;
    justify-content: center;
}

.wheel-info {
    width: 200px;
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.wheel-option {
    width: 100px;
    height: 100px;
    margin: 0;
    padding: 6px;
    border-radius: 50px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
    background-color: rgba(40, 46, 64, 0.95);
    align-items: center;
    justify-content: center;
}

.wheel-option:hover {
    border-color: rgb(255, 255, 255);
    background-color: rgba(70, 110, 170, 0.95);
}

.wheel-option-icon {
    width: 44px;
    height: 44px;
    -unity-background-scale-mode: scale-to-fit;
}

.wheel-option-label {
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Banner of the construction modes, at the bottom of the screen */
.build-mode-root {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 120px;
}

.build-mode-label {
    padding: 8px 16px;
    border-radius: 6px;
    background-color: rgba(20, 24, 36, 0.8);
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-text-align: middle-center;
}
