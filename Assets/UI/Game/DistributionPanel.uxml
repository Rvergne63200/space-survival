<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="DistributionPanelSettings" src="DistributionPanelSettings.uxml" />
    <Style src="Game.uss" />
    <!-- Distribution panel (DistributionPanelUI): state of the circuit and settings. The names are used by the script -->
    <ui:VisualElement name="root" picking-mode="Ignore" class="game-root">
        <ui:VisualElement name="panel" class="game-panel distribution-panel">
            <ui:Label name="title" text="Tableau de distribution" class="panel-title" />
            <ui:Instance template="DistributionPanelSettings" />
            <ui:Button name="close-button" text="Fermer" class="distribution-close" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
